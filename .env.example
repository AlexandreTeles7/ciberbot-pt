# Copia para .env para testar localmente (o .env NÃO vai para o Git).
# No GitHub, estes valores são guardados em Settings → Secrets and variables → Actions.
# Cada canal só fica ativo se as suas variáveis estiverem preenchidas.

# --- Tradução (API da Claude) -------------------------------------------------
ANTHROPIC_API_KEY=
# CIBERBOT_MODELO=claude-haiku-5-5

# --- NVD (opcional: aumenta o limite de pedidos) --------------------------------
# NVD_API_KEY=

# --- Telegram -----------------------------------------------------------------
# Token: criar o bot com o @BotFather. Chat id: ver README. Vários ids separados por vírgula.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord ------------------------------------------------------------------
# Canal → Editar canal → Integrações → Webhooks → Copiar URL
DISCORD_WEBHOOK_URL=

# --- E-mail (SMTP) ------------------------------------------------------------
# Gmail: smtp.gmail.com, porta 587, e uma "palavra-passe de aplicação" (não a palavra-passe normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DE=
EMAIL_PARA=
